{
  "productName": "VK Desktop",
  "appId": "ru.danyadev.vkdesktop",
  "artifactName": "VK Desktop ${os} ${arch}.${ext}",
  "electronVersion": "44.4.3",
  "npmRebuild": false,
  "asar": true,
  "directories": {
    "output": "app"
  },
  "files": [
    "package.json",
    "!node_modules",
    { "from": "app", "to": "", "filter": ["index.js", "preload.js", "notificationPreload.js"] },
    { "from": "app/dist", "to": "dist", "filter": "**/*" },
    { "from": "build", "to": "build", "filter": ["icon.ico", "icon.png"] }
  ],
  "extraMetadata": {
    "name": "vk-desktop",
    "main": "index.js"
  },
  "win": {
    "target": [{
      "target": "dir",
      "arch": ["x64"]
    }]
  },
  "linux": {
    "target": [{
      "target": "zip",
      "arch": ["x64", "arm64"]
    }]
  },
  "mac": {
    "category": "public.app-category.social-networking",
    "gatekeeperAssess": true,
    "target": {
      "target": "dmg",
      "arch": ["arm64", "x64"]
    },
    "electronLanguages": ["ru", "en"]
  }
}
